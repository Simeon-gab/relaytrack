# ---- Termii (SMS fallback) ----
TERMII_API_KEY=
TERMII_SENDER_ID=

# ---- Cron auth (Vercel Cron -> route handlers) ----
CRON_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
