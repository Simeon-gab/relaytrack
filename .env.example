# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Rider location ingest (per-rider signed JWT) ----
RIDER_JWT_SECRET=

# ---- Customer tracking token signing ----
TRACKING_TOKEN_SECRET=

# ---- Maps ----
# v1 pilot uses MapLibre + OpenFreeMap (keyless, free) — see PROGRESS.md
# decisions log 2026-08-15. Google keys kept as the paid upgrade path; leave
# empty unless switching back.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ---- WhatsApp Cloud API (primary notifications) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- Termii (SMS fallback) ----
TERMII_API_KEY=
TERMII_SENDER_ID=

# ---- Cron auth (Vercel Cron -> route handlers) ----
CRON_SECRET=

# ---- Routing / ETA (OSM family — must match OpenFreeMap tiles) ----
# Defaults to the public OSRM demo server; set a hosted OSRM for production.
OSRM_URL=

# ---- App ----
APP_URL=http://localhost:3000
